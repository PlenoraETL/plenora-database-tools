{
  "schema_version": 2,
  "connection_ref": "env:PLENORA_DATABASE_DSN",
  "provider": "postgres",
  "operation": {
    "id": "database.read",
    "source": {
      "catalog": "plenora",
      "schema": "public",
      "object": "events"
    },
    "projection": [
      "event_id",
      "occurred_at",
      "amount",
      "geom"
    ],
    "filter": {
      "op": "and",
      "args": [
        {
          "op": "gte",
          "field": "occurred_at",
          "parameter": "from_timestamp"
        },
        {
          "op": "is_not_null",
          "field": "geom"
        }
      ]
    },
    "order_by": [
      {
        "field": "event_id",
        "direction": "asc"
      }
    ]
  },
  "limits": {
    "max_rows": 1000000,
    "max_batch_bytes": 16777216,
    "max_memory_bytes": 268435456,
    "timeout_ms": 30000
  }
}
