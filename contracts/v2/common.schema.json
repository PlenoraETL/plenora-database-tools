{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plenora.local/database-tools/v2/common.schema.json",
  "title": "Plenora database common definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000]+$"
    },
    "field_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "provider_kind": {
      "enum": [
        "postgres",
        "mysql",
        "mariadb",
        "sqlserver",
        "oracle",
        "db2",
        "sqlite",
        "duckdb"
      ]
    },
    "object_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object"],
      "properties": {
        "catalog": {"$ref": "#/$defs/identifier"},
        "schema": {"$ref": "#/$defs/identifier"},
        "object": {"$ref": "#/$defs/identifier"}
      }
    },
    "mapping_policy": {
      "enum": ["strict", "compatible", "lossy", "native"]
    },
    "transaction_profile": {
      "enum": [
        "read_only",
        "single_transaction",
        "staged_swap",
        "chunk_committed",
        "best_effort_ddl"
      ]
    }
  }
}
