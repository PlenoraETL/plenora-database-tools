T = TypeVar("T")  # noqa: PYI001

class OrmError(PlenoraError): ...
class OrmMappingError(OrmError): ...
class OrmStateError(OrmError): ...
class StaleObjectError(OrmError): ...
class OrmUnsupportedError(OrmError): ...

class ObjectState(str, Enum):
    TRANSIENT: ObjectState
    PENDING: ObjectState
    PERSISTENT: ObjectState
    DELETED: ObjectState
    DETACHED: ObjectState

@dataclass(frozen=True, slots=True)
class Geometry:
    srid: int
    dimensions: str
    semantics: str
