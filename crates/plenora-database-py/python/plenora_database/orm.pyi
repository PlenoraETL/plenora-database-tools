        self, value: bytes | bytearray | SpatialReference
    ) -> SpatialReference: ...
    def bind(self, name: str) -> Expression: ...
    def predicate(
        self,
        function: str,
        column: Column,
        reference: Expression,
        distance: Expression | None = None,
    ) -> Predicate: ...
    def function(
        self, function: str, column: Column, *arguments: Expression
    ) -> Expression: ...

