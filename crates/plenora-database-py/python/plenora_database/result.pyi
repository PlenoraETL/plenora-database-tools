from collections.abc import Iterator, Mapping
from typing import Any

from .expression import Column

class NoResultFound(LookupError): ...
class MultipleResultsFound(LookupError): ...

class MutationResult:
    operation: str
    provider: str
    affected_rows: int | None
    def __init__(self, operation: str, provider: str, affected_rows: int | None) -> None: ...
    @property
    def count_is_known(self) -> bool: ...
    def __bool__(self) -> bool: ...
    def __repr__(self) -> str: ...

class Row:
    def __init__(self, values: Mapping[str, Any]) -> None: ...
    def __getitem__(self, key: int | str | Column) -> Any: ...
    def keys(self) -> tuple[str, ...]: ...
    def values(self) -> tuple[Any, ...]: ...
    def items(self) -> tuple[tuple[str, Any], ...]: ...
    def as_dict(self) -> dict[str, Any]: ...
    def __iter__(self) -> Iterator[Any]: ...
    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...

class Result:
    def __init__(self, rows: list[dict[str, Any]]) -> None: ...
    def keys(self) -> tuple[str, ...]: ...
    def all(self) -> list[dict[str, Any]]: ...
    def first(self) -> dict[str, Any] | None: ...
    def rows(self) -> list[Row]: ...
    def row_first(self) -> Row | None: ...
    def one(self) -> dict[str, Any]: ...
    def row_one(self) -> Row: ...
    def one_or_none(self) -> dict[str, Any] | None: ...
    def row_one_or_none(self) -> Row | None: ...
    def tuples(self) -> list[tuple[Any, ...]]: ...
    def scalar(self) -> Any: ...
    def scalar_one(self) -> Any: ...
    def scalar_one_or_none(self) -> Any: ...
    def __iter__(self) -> Iterator[dict[str, Any]]: ...
    def __len__(self) -> int: ...
