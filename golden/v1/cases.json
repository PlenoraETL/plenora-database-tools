      "input": {"wkt": "POINT ZM (9.19 45.4642 120.5 7)", "srid": 4326},
      "expected": {"dimensions": "xyzm", "silent_dimension_drop": false}
    },
    {
      "id": "geometry.unknown-srid",
      "dataset": "geometry_v1",
      "category": "geometry",
      "classification": "corrected",
      "providers": ["postgres", "mysql", "mariadb", "sqlserver", "oracle", "db2", "sqlite", "duckdb", "arcgis"],
      "status": "database_required",
      "tags": ["srid", "unknown"],
      "input": {"wkt": "POINT (0 0)", "srid": null},
      "expected": {"srid": null, "default_to_4326": false}
    },
    {
      "id": "write.append-atomic",
      "dataset": "scalars_v1",
      "category": "write",
      "classification": "normative",
      "providers": ["postgres", "mysql", "mariadb", "sqlserver", "oracle", "db2", "sqlite", "duckdb"],
      "status": "database_required",
      "tags": ["append", "transaction"],
      "input": {"mode": "append", "rows": 10000, "fault_after_row": 5000},
      "expected": {"profile": "single_transaction", "outcome": "rolled_back", "remote_rows_added": 0}
    },
    {
      "id": "write.upsert-composite-key",
      "dataset": "keys_conflicts_v1",
      "category": "write",
      "classification": "new",
      "providers": ["postgres", "mysql", "mariadb", "sqlserver", "oracle", "db2", "sqlite", "duckdb"],
