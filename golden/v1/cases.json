{
  "schema_version": 1,
  "suite": "golden-v1",
  "cases": [
    {
      "id": "scalar.signed-boundaries",
      "dataset": "scalars_v1",
      "category": "scalar",
      "classification": "normative",
      "providers": ["postgres", "mysql", "mariadb", "sqlserver", "oracle", "db2", "sqlite", "duckdb"],
      "status": "offline_ready",
      "tags": ["integer", "exact"],
      "input": {"values": [-9223372036854775808, -1, 0, 1, 9223372036854775807]},
      "expected": {"comparison": "exact", "float_coercion": false}
    },
    {
      "id": "scalar.decimal-high-precision",
      "dataset": "scalars_v1",
      "category": "scalar",
      "classification": "corrected",
      "providers": ["postgres", "mysql", "mariadb", "sqlserver", "oracle", "db2", "duckdb"],
      "status": "database_required",
      "tags": ["decimal", "precision", "scale"],
      "input": {"values_as_text": ["0", "-0.01", "12345678901234567890.123456789012345678"]},
      "expected": {"comparison": "exact_decimal", "float_coercion": false, "loss_report_on_narrowing": true}
    },
    {
      "id": "scalar.unicode-normalization",
      "dataset": "scalars_v1",
      "category": "scalar",
      "classification": "normative",
      "providers": ["postgres", "mysql", "mariadb", "sqlserver", "oracle", "db2", "sqlite", "duckdb", "arcgis"],
      "status": "database_required",
      "tags": ["unicode", "emoji", "combining"],
      "input": {"values": ["caffè", "caffé", "🗺️", "東京"]},
      "expected": {"comparison": "codepoint_exact", "implicit_normalization": false}
    },
    {
      "id": "temporal.timezone-dst-boundary",
      "dataset": "scalars_v1",
      "category": "temporal",
      "classification": "corrected",
      "providers": ["postgres", "mysql", "mariadb", "sqlserver", "oracle", "db2", "sqlite", "duckdb", "arcgis"],
      "status": "database_required",
      "tags": ["timestamp", "timezone", "dst"],
      "input": {"instant": "2025-10-26T00:30:00Z", "zone": "Europe/Berlin"},
      "expected": {"preserve_instant": true, "timezone_loss_is_reported": true}
    },
    {
      "id": "binary.empty-null-and-bytes",
      "dataset": "scalars_v1",
      "category": "binary",
      "classification": "normative",
      "providers": ["postgres", "mysql", "mariadb", "sqlserver", "oracle", "db2", "sqlite", "duckdb"],
      "status": "offline_ready",
      "tags": ["binary", "null"],
      "input": {"base64_values": ["", "AAECA/8="], "includes_null": true},
      "expected": {"empty_distinct_from_null": true, "comparison": "byte_exact"}
    },
    {
      "id": "schema.empty-with-fields",
      "dataset": "empty_v1",
      "category": "schema",
      "classification": "normative",
      "providers": ["postgres", "mysql", "mariadb", "sqlserver", "oracle", "db2", "sqlite", "duckdb", "arcgis"],
      "status": "database_required",
      "tags": ["empty", "schema"],
      "input": {"rows": 0, "fields": ["id", "name", "geom"]},
      "expected": {"schema_preserved": true, "rows": 0}
    },
    {
      "id": "schema.quoted-identifiers",
      "dataset": "wide_rows_v1",
      "category": "schema",
      "classification": "normative",
      "providers": ["postgres", "mysql", "mariadb", "sqlserver", "oracle", "db2", "sqlite", "duckdb"],
      "status": "database_required",
