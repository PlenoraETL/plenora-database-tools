      "input": {"fault": "connection_lost_after_commit_request"},
      "expected": {"outcome": "outcome_unknown", "automatic_retry_allowed": false}
    },
    {
      "id": "arcgis.pagination-objectid-windows",
      "dataset": "arcgis_features_v1",
      "category": "arcgis",
      "classification": "new",
      "providers": ["arcgis"],
