    {
      "id": "arcgis.applyedits-partial",
      "dataset": "arcgis_features_v1",
      "category": "arcgis",
      "classification": "corrected",
      "providers": ["arcgis"],
      "status": "database_required",
      "tags": ["applyedits", "partial"],
      "input": {"adds": 10, "failed_object_indexes": [4], "rollback_on_failure": false},
