    },
    {
      "id": "write.replace-staged",
      "dataset": "wide_rows_v1",
      "category": "write",
      "classification": "new",
      "providers": ["postgres", "mysql", "mariadb", "sqlserver", "oracle", "db2", "duckdb"],
      "status": "database_required",
      "tags": ["replace", "staging"],
      "input": {"mode": "replace", "fault_phase": "finalizing"},
      "expected": {"profile": "staged_swap", "old_or_new_visible": true, "half_schema_visible": false}
    },
    {
      "id": "outcome.commit-response-lost",
      "dataset": "keys_conflicts_v1",
      "category": "outcome",
      "classification": "corrected",
      "providers": ["postgres", "mysql", "mariadb", "sqlserver", "oracle", "db2", "sqlite", "duckdb"],
      "status": "database_required",
