    {
      "id": "security.redacted-connection-error",
      "dataset": "scalars_v1",
      "category": "security",
      "classification": "normative",
      "providers": ["postgres", "mysql", "mariadb", "sqlserver", "oracle", "db2", "sqlite", "duckdb", "arcgis"],
      "status": "offline_ready",
      "tags": ["secrets", "errors"],
      "input": {"secret_markers": ["password", "token", "dsn"], "operation": "test_connection"},
