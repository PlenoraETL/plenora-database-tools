      "expected": {"comparison": "semantic_structural", "ring_count": 2, "srid": 3857}
    },
    {
      "id": "geometry.empty-vs-null",
      "dataset": "geometry_v1",
      "category": "geometry",
      "classification": "corrected",
      "providers": ["postgres", "mysql", "mariadb", "sqlserver", "oracle", "db2", "sqlite", "duckdb", "arcgis"],
      "status": "database_required",
      "tags": ["empty", "null"],
      "input": {"values": [{"wkt": "POINT EMPTY", "srid": 4326}, null]},
      "expected": {"empty_distinct_from_null": true}
    },
    {
      "id": "geometry.xyzm-preservation",
      "dataset": "geometry_v1",
      "category": "geometry",
      "classification": "corrected",
      "providers": ["postgres", "mysql", "mariadb", "sqlserver", "oracle", "db2", "sqlite", "duckdb", "arcgis"],
      "status": "database_required",
